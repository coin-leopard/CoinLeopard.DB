<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.5</Version>
    <Title>CoinLeopard.DB.Extensions.PostgreSQL</Title>
    <Authors>AT Jevon</Authors>
    <Description>Coin Leopard database</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/coin-leopard/CoinLeopard.DB/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coin-leopard/CoinLeopard.DB.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.Design" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CmdScale.EntityFrameworkCore.TimescaleDB" Version="10.1.2" />
    <PackageReference Include="CmdScale.EntityFrameworkCore.TimescaleDB.Design" Version="10.1.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CoinLeopard.DB.Migrations.PostgreSQL\CoinLeopard.DB.Migrations.PostgreSQL.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\CoinLeopard.DB.Ticks\CoinLeopard.DB.Ticks.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\CoinLeopard.DB\CoinLeopard.DB.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Explicitly bundle the project reference DLLs since PrivateAssets=all excludes them from lib -->
    <None Include="$(OutputPath)CoinLeopard.DB.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
    <None Include="$(OutputPath)CoinLeopard.DB.Entities.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
    <None Include="$(OutputPath)CoinLeopard.DB.Migrations.PostgreSQL.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
    <None Include="$(OutputPath)CoinLeopard.DB.Ticks.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
  </ItemGroup>
</Project>